# WanderLink Backend Environment Configuration
# Copy this file to .env or export these environment variables before running

# Server Port
PORT=8080

# MySQL Database Configuration
DB_URL=jdbc:mysql://localhost:3306/wanderlink?createDatabaseIfNotExist=true&useSSL=false&allowPublicKeyRetrieval=true&serverTimezone=UTC
DB_USERNAME=root
DB_PASSWORD=your_mysql_password_here

# Frontend URL for CORS
FRONTEND_URL=http://localhost:5173
